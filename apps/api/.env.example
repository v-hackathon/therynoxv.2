NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/therynox_dev?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"

# Email OTP: choose Resend OR SMTP. For Gmail SMTP, use a Google App Password (not your normal password).
RESEND_API_KEY=
AUTH_EMAIL_FROM="Therynox <yourgmail@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_16_character_google_app_password
# Google Identity Services: use the same Web Client ID in API and storefront env files.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
OTP_HASH_SECRET=replace-with-a-different-random-secret-at-least-32-characters-long

# Therynox IDs (THY-XXXXXXXX) are generated by the API; no extra secret is needed.
